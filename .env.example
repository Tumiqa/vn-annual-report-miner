# =====================================================================
# vn-annual-report-miner (.env) - Cấu hình hệ thống trọn gói
# =====================================================================

# 1. Hugging Face Token (Dùng để tải 702 chỉ tiêu BCTC không bị giới hạn IP)
# Nếu để trống, hệ thống sẽ tự động dùng Token fallback mặc định của dự án.
# Bạn có thể điền token cá nhân của bạn từ https://huggingface.co/settings/tokens
HF_TOKEN=

# 2. Đường dẫn Tesseract OCR (Tùy chọn - Hệ thống tự nhận diện nếu cài mặc định)
# Chỉ cần thiết nếu cài Tesseract ở vị trí tùy biến:
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# 3. Thư mục lưu trữ dữ liệu & Cache (Tùy chọn)
# ARMINER_CACHE_DIR=./data/downloads
# ARMINER_REPORTS_DIR=./data/reports
